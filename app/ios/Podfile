# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Aligne sur IPHONEOS_DEPLOYMENT_TARGET du projet Xcode. min_ios_version_supported
# vaut 13.4 avec React Native 0.75.4, en dessous de ce qu'exige google-cast-sdk
# 4.8.4 : CocoaPods echouait sur "required a higher minimum deployment target".
platform :ios, '15.6'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ing framework linking."
  use_frameworks! :linkage => linkage.to_sym
end

target 'Movix' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  pod 'google-cast-sdk', '~> 4.8.4'

  target 'MovixTests' do
    inherit! :complete
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
  end
end
