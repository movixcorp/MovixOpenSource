<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Le trafic en clair doit rester autorisé : certaines sources de flux
      (Vavoo notamment) répartissent leurs edges sur des adresses IP nues, qui
      n'ont pas de certificat et ne sont donc servies qu'en http. Avec
      `cleartextTrafficPermitted="false"`, Android refusait ces requêtes en
      quelques millisecondes — « Network request failed » — et le proxy de
      l'app ne pouvait jamais aboutir. Cette base-config contredisait aussi
      `android:usesCleartextTraffic="true"` déjà déclaré dans le manifeste, et
      c'est elle qui gagnait.

      Les adresses changent à chaque résolution : les lister par domaine est
      impossible. iOS autorise déjà ces chargements via NSAllowsArbitraryLoads.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
