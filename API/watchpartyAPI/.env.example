WATCHPARTY_PORT=YOUR_WATCHPARTY_PORT # Exemple: 25566
WATCHPARTY_CORS_CREDENTIALS=YOUR_WATCHPARTY_CORS_CREDENTIALS # Exemple: true

# Origines autorisées. Si non renseignées, seul le dev local (localhost:3000) est accepté.
# Ne jamais mettre `*` ou `true` en production : les credentials CORS sont alors
# désactivés de force par le serveur.
#
# Trois formes possibles, combinables par des virgules :
#   - une origine     : http://localhost:3000
#   - un domaine nu   : movix.fun            (https:// est ajouté)
#   - une URL de liste: https://movix.online/address.json
#
# Une URL avec un CHEMIN est traitée comme une liste de miroirs à télécharger.
# Le serveur y retient `primary` et `active`, et IGNORE `blocked` : un domaine
# saisi comme bloqué cesse donc d'être autorisé au rafraîchissement suivant.
# La liste est chargée au démarrage puis toutes les 10 minutes (nouvelle
# tentative après 1 minute en cas d'échec) ; si le téléchargement échoue, la
# dernière liste valide reste active. Garder une origine statique en plus de
# l'URL évite tout blocage si la liste est injoignable au tout premier démarrage.
WATCHPARTY_REST_CORS_ORIGIN=YOUR_WATCHPARTY_REST_CORS_ORIGIN # Exemple: http://localhost:3000
WATCHPARTY_SOCKET_CORS_ORIGIN=YOUR_WATCHPARTY_SOCKET_CORS_ORIGIN # Exemple: http://localhost:3000
WATCHPARTY_SOCKET_CORS_METHODS=GET,POST # Exemple: GET,POST

# Secret d'administration protégeant GET /api/watchparty/all (header `x-admin-secret`).
# Cette route expose TOUTES les rooms, privées incluses, avec leurs URLs de flux.
# Si la variable est vide ou absente, la route renvoie 503 et reste inaccessible.
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WATCHPARTY_ADMIN_SECRET=YOUR_WATCHPARTY_ADMIN_SECRET # Exemple: 7Qk2mF9xR1pL4vT8wZ0aB3cN6dE5gH2j

# Limites anti-abus (valeurs par défaut si non renseignées)
WATCHPARTY_MAX_BODY=YOUR_WATCHPARTY_MAX_BODY # Défaut: 256kb
WATCHPARTY_MAX_ROOMS=YOUR_WATCHPARTY_MAX_ROOMS # Défaut: 500
WATCHPARTY_MAX_ROOMS_PER_IP=YOUR_WATCHPARTY_MAX_ROOMS_PER_IP # Défaut: 5