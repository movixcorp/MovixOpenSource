PORT=YOUR_PROXIESEMBED_PORT # Exemple: 8080
DB_HOST=YOUR_DB_HOST # Exemple: localhost
DB_PORT=YOUR_DB_PORT # Exemple: 3306
DB_USER=YOUR_DB_USER # Exemple: root
DB_PASSWORD=YOUR_DB_PASSWORD # Exemple: motdepassefort
DB_NAME=YOUR_DB_NAME # Exemple: movix
PROXY_BASE=YOUR_PROXY_BASE # Base publique de CE service proxiesembed. Exemple: http://localhost:25569
# Secret HMAC partagé avec mainapi (MEME VALEUR des deux côtés). Sans lui, le
# service refuse tout trafic média : il ne peut plus distinguer ses propres URLs
# d'une URL forgée. Générer avec: openssl rand -hex 32
MEDIA_SIGNING_SECRET=YOUR_MEDIA_SIGNING_SECRET
# Durée de validité d'une URL signée, en secondes. Doit couvrir une lecture
# complète (défaut 43200 = 12 h). Même valeur que côté mainapi.
MEDIA_SIGNATURE_TTL=43200
# Clé interne mainapi -> proxiesembed (MEME VALEUR des deux côtés). Protège les
# endpoints d'extraction (/api/extract-*, /drm/extract, /api/debrid/unlock), qui
# ne sont plus joignables depuis le navigateur. Générer avec: openssl rand -hex 32
INTERNAL_API_KEY=YOUR_INTERNAL_API_KEY
PROXIES_SOCKS5_JSON=YOUR_PROXIES_SOCKS5_JSON # Exemple: [{"url":"socks5://user:pass@127.0.0.1:1080"}] ou [{"host":"127.0.0.1","port":1080,"auth":"user:pass","type":"socks5"}]
SIBNET_PROXY_SOCKS5_JSON=YOUR_SIBNET_PROXY_SOCKS5_JSON # Exemple: {"url":"socks5://user:pass@127.0.0.1:1081"} ou {"host":"127.0.0.1","port":1081,"auth":"user:pass","type":"socks5"}
FRANCETV_EMAIL=YOUR_FRANCETV_EMAIL
FRANCETV_PASSWORD=YOUR_FRANCETV_PASSWORD
DEEPBRID_API_KEY=YOUR_DEEPBRID_API_KEY
REAL_DEBRID_API_KEY=YOUR_REAL_DEBRID_API_KEY
DEBRIDR_ACCOUNT_KEY=YOUR_DEBRIDR_ACCOUNT_KEY
